<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trang Chủ</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/mobile.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://demos.creative-tim.com/notus-js/assets/styles/tailwind.css">
    <!-- link swiper-->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link rel="stylesheet"
        href="https://demos.creative-tim.com/notus-js/assets/vendor/@fortawesome/fontawesome-free/css/all.min.css">
    <script src="/js/auth-jwt.js"></script>
  <style>
    html,
    body {
      height: 100%;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    main {
      flex: 1 0 auto;
    }

    footer {
      flex-shrink: 0;
    }

    .modern-container {
      max-width: 1200px;
      margin: 48px auto 0 auto;
      padding: 2.5rem 2rem 2rem 2rem;
      background: #fff;
      border-radius: 18px;
      box-shadow: 0 4px 24px rgba(44,62,80,0.10);
      border: 1px solid #e3e6ed;
      animation: fadeIn 0.5s;
    }
    .modern-title {
      font-size: 2rem;
      font-weight: 700;
      color: #2375D8;
      text-align: center;
      margin-bottom: 2rem;
      letter-spacing: 1px;
    }
    .modern-form-group {
      margin-bottom: 1.5rem;
    }
    .modern-form-group label {
      display: block;
      font-weight: 600;
      color: #374151;
      margin-bottom: 0.5rem;
      letter-spacing: 0.5px;
    }
    .modern-form-control, .modern-form-control:focus {
      width: 100%;
      padding: 0.75rem 1rem;
      border: 1.5px solid #e5e7eb;
      border-radius: 8px;
      font-size: 1rem;
      background: #f9fafb;
      transition: border-color 0.2s, box-shadow 0.2s;
      outline: none;
      color: #22223b;
    }
    .modern-form-control:focus {
      border-color: #2375D8;
      box-shadow: 0 0 0 2px #2375d830;
      background: #fff;
    }
    .modern-form-control[readonly] {
      background-color: #e9ecef;
      cursor: not-allowed;
    }
    .modern-btn-primary {
      width: 100%;
      background: linear-gradient(90deg, #2375D8 0%, #0c9083 100%);
      color: #fff;
      font-weight: 700;
      font-size: 1.1rem;
      padding: 0.85rem 0;
      border: none;
      border-radius: 10px;
      box-shadow: 0 4px 16px rgba(36,117,216,0.10);
      transition: background 0.2s, transform 0.15s;
      cursor: pointer;
      margin-top: 0.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.7rem;
    }
    .modern-btn-primary:hover {
      background: linear-gradient(90deg, #0c9083 0%, #2375D8 100%);
      transform: translateY(-2px) scale(1.03);
      box-shadow: 0 8px 24px rgba(36,117,216,0.18);
    }
    .modern-btn-danger {
      width: 100%;
      background: #ef4444;
      color: #fff;
      font-weight: 700;
      font-size: 1.1rem;
      padding: 0.85rem 0;
      border: none;
      border-radius: 10px;
      margin-top: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.7rem;
      transition: background 0.2s, transform 0.15s;
      cursor: pointer;
    }
    .modern-btn-danger:hover {
      background: #dc2626;
      transform: translateY(-2px);
    }
    .modern-btn-secondary {
      width: 100%;
      background: #e5e7eb;
      color: #2375D8;
      font-weight: 700;
      font-size: 1.1rem;
      padding: 0.85rem 0;
      border: none;
      border-radius: 10px;
      margin-top: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.7rem;
      text-decoration: none;
      transition: background 0.2s, color 0.2s;
    }
    .modern-btn-secondary:hover {
      background: #d1d5db;
      color: #0c9083;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(18px);}
      to { opacity: 1; transform: translateY(0);}
    }
  </style>

<body>
  <%- include('../shared/header.ejs') %>

  <main>
    <form id="scheduleForm" class="modern-container" autocomplete="off">
      <legend class="modern-title">
        <i class="fas fa-calendar-edit mr-2"></i>
        Edit Schedule
      </legend>
      <div id="messageContainer"></div>

      <div class="modern-form-group">
        <label for="class_id"><i class="fas fa-chalkboard mr-2"></i>Class</label>
        <select id="class_id" name="class_id" class="modern-form-control" required>
          <option value="">Loading classes...</option>
        </select>
      </div>

      <div class="modern-form-group">
        <label for="schedule_date"><i class="fas fa-calendar-day mr-2"></i>Date</label>
        <input type="date" 
               id="schedule_date" 
               name="schedule_date" 
               class="modern-form-control" 
               required>
      </div>

      <div class="modern-form-group">
        <label for="day_of_week"><i class="fas fa-calendar-alt mr-2"></i>Day of Week</label>
        <select id="day_of_week" name="day_of_week" 
                class="modern-form-control"
                readonly
                required>
          <option value="Monday">Monday</option>
          <option value="Tuesday">Tuesday</option>
          <option value="Wednesday">Wednesday</option>
          <option value="Thursday">Thursday</option>
          <option value="Friday">Friday</option>
          <option value="Saturday">Saturday</option>
          <option value="Sunday">Sunday</option>
        </select>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="modern-form-group">
          <label for="start_time"><i class="fas fa-clock mr-2"></i>Start Time</label>
          <input type="time" 
                 id="start_time" 
                 name="start_time" 
                 step="3600"
                 class="modern-form-control" 
                 required>
        </div>

        <div class="modern-form-group">
          <label for="end_time"><i class="fas fa-clock mr-2"></i>End Time</label>
          <input type="time" 
                 id="end_time" 
                 name="end_time" 
                 step="3600"
                 class="modern-form-control" 
                 required>
        </div>
      </div>

      <button type="submit" class="modern-btn-primary">
        <i class="fas fa-save"></i>
        Update Schedule
      </button>
      <button type="button" onclick="deleteSchedule()" class="modern-btn-danger">
        <i class="fas fa-trash"></i>
        Delete Schedule
      </button>
      <a href="/schedules" class="modern-btn-secondary">
        <i class="fas fa-arrow-left"></i> Back
      </a>
    </form>
  </main>

  <script src="/js/script.js"></script>
  <script src="/js/main.js"></script>
  <script>
    const scheduleId = window.location.pathname.split('/')[2];
    
    async function loadScheduleData() {
      try {
        const response = await AuthJWT.apiCall(`/api/schedules/${scheduleId}/edit`, { method: 'GET' });
        if (!response.ok) throw new Error('Failed to load schedule');
        const data = await response.json();
        
        // Populate classes
        const classSelect = document.getElementById('class_id');
        classSelect.innerHTML = '';
        data.classes.forEach(cls => {
          const option = document.createElement('option');
          option.value = cls.id;
          option.textContent = `${cls.class_name} - ${cls.course_name} (${cls.teacher_name})`;
          option.dataset.courseStart = cls.start_date;
          option.dataset.courseEnd = cls.end_date;
          if (cls.id === data.schedule.class_id) {
            option.selected = true;
          }
          classSelect.appendChild(option);
        });
        
        // Fill in schedule data
        document.getElementById('schedule_date').value = data.schedule.formatted_schedule_date;
        document.getElementById('start_time').value = data.schedule.formatted_start_time;
        document.getElementById('end_time').value = data.schedule.formatted_end_time;
        document.getElementById('day_of_week').value = data.schedule.day_of_week;
        
        updateDateRestrictions();
      } catch (error) {
        console.error('Error loading schedule:', error);
        document.getElementById('messageContainer').innerHTML = `
          <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
            Error loading schedule: ${error.message}
          </div>
        `;
      }
    }
    
    function updateDateRestrictions() {
      const classSelect = document.getElementById('class_id');
      const selectedOption = classSelect.options[classSelect.selectedIndex];
      const dateInput = document.getElementById('schedule_date');
      dateInput.min = selectedOption.dataset.courseStart;
      dateInput.max = selectedOption.dataset.courseEnd;
    }
    
    document.getElementById('scheduleForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      try {
        const classSelect = document.getElementById('class_id');
        const selectedOption = classSelect.options[classSelect.selectedIndex];
        
        const scheduleDate = new Date(document.getElementById('schedule_date').value);
        const courseStart = new Date(selectedOption.dataset.courseStart);
        const courseEnd = new Date(selectedOption.dataset.courseEnd);
        
        if (scheduleDate < courseStart || scheduleDate > courseEnd) {
          document.getElementById('messageContainer').innerHTML = `
            <div class="bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-3 rounded mb-4">
              Schedule date must be within the course dates
            </div>
          `;
          return;
        }
        
        const startTime = document.getElementById('start_time').value;
        const endTime = document.getElementById('end_time').value;
        
        if (startTime >= endTime) {
          document.getElementById('messageContainer').innerHTML = `
            <div class="bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-3 rounded mb-4">
              End time must be after start time
            </div>
          `;
          return;
        }
        
        const payload = {
          class_id: parseInt(document.getElementById('class_id').value),
          schedule_date: document.getElementById('schedule_date').value,
          day_of_week: document.getElementById('day_of_week').value,
          start_time: startTime,
          end_time: endTime
        };
        
        const response = await AuthJWT.apiCall(`/api/schedules/${scheduleId}`, {
          method: 'POST',
          body: JSON.stringify(payload),
          headers: {
            'Content-Type': 'application/json'
          }
        });
        
        if (response.ok) {
          document.getElementById('messageContainer').innerHTML = `
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
              Schedule updated successfully! Redirecting...
            </div>
          `;
          setTimeout(() => window.location.href = '/schedules', 1500);
        } else {
          const error = await response.json();
          document.getElementById('messageContainer').innerHTML = `
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
              Error: ${error.message || 'Failed to update schedule'}
            </div>
          `;
        }
      } catch (error) {
        console.error('Error updating schedule:', error);
        document.getElementById('messageContainer').innerHTML = `
          <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
            Error: ${error.message}
          </div>
        `;
      }
    });
    
    async function deleteSchedule() {
      if (confirm('Are you sure you want to delete this schedule?')) {
        try {
          const response = await AuthJWT.apiCall(`/api/schedules/${scheduleId}`, { method: 'DELETE' });
          if (response.ok) {
            document.getElementById('messageContainer').innerHTML = `
              <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
                Schedule deleted successfully! Redirecting...
              </div>
            `;
            setTimeout(() => window.location.href = '/schedules', 1500);
          } else {
            document.getElementById('messageContainer').innerHTML = `
              <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
                Failed to delete schedule
              </div>
            `;
          }
        } catch (error) {
          document.getElementById('messageContainer').innerHTML = `
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
              Error: ${error.message}
            </div>
          `;
        }
      }
    }
    
    document.getElementById('class_id').addEventListener('change', updateDateRestrictions);
    
    document.getElementById('schedule_date').addEventListener('change', function() {
      const dateValue = this.value;
      if (!dateValue) return;
      const parts = dateValue.split('-');
      const year = parseInt(parts[0], 10);
      const month = parseInt(parts[1], 10) - 1;
      const day = parseInt(parts[2], 10);
      const selectedDate = new Date(Date.UTC(year, month, day));
      const dayIndex = selectedDate.getUTCDay();
      const daysOfWeek = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
      document.getElementById('day_of_week').value = daysOfWeek[dayIndex];
    });
    
    document.addEventListener('DOMContentLoaded', loadScheduleData);
  </script>

  <footer class="relative bg-blueGray-200 pt-8 pb-6">
    <div class="container mx-auto px-4">
            <div class="flex flex-wrap text-left lg:text-left">
                <div class="w-full lg:w-6/12 px-4">
                    <h4 class="text-3xl fonat-semibold text-blueGray-700">Liên hệ với chúng tôi!</h4>
                    <h5 class="text-lg mt-0 mb-2 text-blueGray-600">
                        Tìm kiếm chúng tôi trên bất kỳ mạng xã hội nào và gửi cho chúng tôi một tin nhắn! Chúng tôi sẽ
                        trả
                        lời bạn
                        ngay khi có thể.
                    </h5>
                    <div class="mt-6 lg:mb-0 mb-6">
                        <button
                            class="bg-white text-lightBlue-400 shadow-lg font-normal h-10 w-10 items-center justify-center align-center rounded-full outline-none focus:outline-none mr-2"
                            type="button">
                            <i class="fab fa-twitter"></i></button><button
                            class="bg-white text-lightBlue-600 shadow-lg font-normal h-10 w-10 items-center justify-center align-center rounded-full outline-none focus:outline-none mr-2"
                            type="button">
                            <i class="fab fa-facebook-square"></i></button><button
                            class="bg-white text-pink-400 shadow-lg font-normal h-10 w-10 items-center justify-center align-center rounded-full outline-none focus:outline-none mr-2"
                            type="button">
                            <i class="fab fa-dribbble"></i></button><button
                            class="bg-white text-blueGray-800 shadow-lg font-normal h-10 w-10 items-center justify-center align-center rounded-full outline-none focus:outline-none mr-2"
                            type="button">
                            <i class="fab fa-github"></i>
                        </button>
                    </div>
                </div>
                <div class="w-full lg:w-6/12 px-4">
                    <div class="flex flex-wrap items-top mb-6">
                        <div class="w-full lg:w-4/12 px-4 ml-auto">
                            <span class="block uppercase text-blueGray-500 text-sm font-semibold mb-2">Bạn Đang Tìm
                                Kiếm</span>
                            <ul class="list-unstyled">
                                <li>
                                    <a class="text-blueGray-600 hover:text-blueGray-800 font-semibold block pb-2 text-sm"
                                        href="">Liên
                                        Hệ</a>
                                </li>
                                <li>
                                    <a class="text-blueGray-600 hover:text-blueGray-800 font-semibold block pb-2 text-sm"
                                        href="">Thông
                                        Tin Mới</a>
                                </li>
                                <li>
                                    <a class="text-blueGray-600 hover:text-blueGray-800 font-semibold block pb-2 text-sm"
                                        href="">Tuyển
                                        Dụng</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <hr class="my-6 border-blueGray-300">
            <div class="flex flex-wrap items-center md:justify-between justify-center">
                <div class="w-full md:w-4/12 px-4 mx-auto text-center">
                    <div class="text-sm text-blueGray-500 font-semibold py-1">
                        Copyright © <span id="get-current-year">2025</span><a
                            href="https://www.facebook.com/ttgdvpttnht" class="text-blueGray-500 hover:text-gray-800"
                            target="_blank"> Talent Education</a>. Made by
                        <a href="https://github.com/Rin-0808" class="text-blueGray-500 hover:text-blueGray-800">Rin</a>.
                    </div>
                </div>
            </div>
        </div>
    </footer>
  <script src="/js/main.js"></script>
</body>

</html>